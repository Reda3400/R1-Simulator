{
  "name": "r1",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/r1-dev.mjs",
    "up": "node scripts/r1-dev.mjs",
    "postinstall": "node scripts/r1-setup.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "r1:configure": "cmake -S \"../R1 Engine\" -B \"../R1 Engine/build\" -DCMAKE_BUILD_TYPE=Release -DR1_BUILD_NODE_BINDING=ON",
    "r1:build": "cmake --build \"../R1 Engine/build\" --target r1node -j8",
    "r1:test": "ctest --test-dir \"../R1 Engine/build\" --output-on-failure",
    "test": "node --test \"tests/*.test.js\"",
    "verify:r1": "node scripts/r1-verify.mjs"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "h3-js": "^4.5.0",
    "leaflet": "^1.9.4",
    "vue": "^3.5.41",
    "vue-leaflet": "^0.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2"
  }
}
